##############################################################################
# OwnDatabase — Environment Variables
#
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
#
# Required values are marked with :?  (Docker Compose will fail without them)
# Optional values have defaults shown.
##############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# GENERAL
# ─────────────────────────────────────────────────────────────────────────────

# Your domain name (use 'localhost' for local development)
DOMAIN=localhost

# Application environment
NODE_ENV=development

# Log level: error | warn | info | debug | trace
LOG_LEVEL=info

# Public-facing site URL (used for OAuth redirects, email links)
SITE_URL=http://localhost

# ─────────────────────────────────────────────────────────────────────────────
# POSTGRESQL
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production_use_long_random_string
POSTGRES_DB=owndatabase

# ─────────────────────────────────────────────────────────────────────────────
# PGBOUNCER
# ─────────────────────────────────────────────────────────────────────────────

PGBOUNCER_MAX_CONN=200
PGBOUNCER_POOL_SIZE=25

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────

REDIS_PASSWORD=change_me_in_production_use_long_random_string
REDIS_MAX_MEMORY=256mb

# ─────────────────────────────────────────────────────────────────────────────
# JWT / SESSIONS
# ─────────────────────────────────────────────────────────────────────────────

# Must be at least 32 characters, random
# Generate: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# JWT expiry in seconds (default: 1 hour)
JWT_EXPIRES_IN=3600

# Refresh token expiry in seconds (default: 7 days)
REFRESH_TOKEN_EXPIRES_IN=604800

# ─────────────────────────────────────────────────────────────────────────────
# SECRET ENCRYPTION
# ─────────────────────────────────────────────────────────────────────────────

# Used to encrypt secrets at rest (AES-256-GCM)
# Must be exactly 32 bytes hex-encoded (64 hex chars)
# Generate: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# ─────────────────────────────────────────────────────────────────────────────
# OAUTH PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL / SMTP
# ─────────────────────────────────────────────────────────────────────────────

# Leave blank in development (emails logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# ─────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE
# ─────────────────────────────────────────────────────────────────────────────

# Storage backend: s3 (any S3-compatible service, incl. the bundled SeaweedFS) | fs (local disk volume)
STORAGE_BACKEND=s3
# Largest accepted upload in bytes (100 MB)
MAX_UPLOAD_SIZE=104857600

# MinIO credentials (local development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production

# S3-compatible settings
# Bundled SeaweedFS (compose service "minio"): http://minio:8333
# For AWS S3: https://s3.amazonaws.com
# For Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=http://minio:8333
S3_BUCKET=owndatabase
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_in_production
S3_REGION=us-east-1
# Set to true for MinIO and non-AWS S3-compatible services
S3_FORCE_PATH_STYLE=true

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=OwnDatabase
# Control API URL as seen from the browser
NEXT_PUBLIC_CONTROL_API_URL=http://localhost/api

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────────────────────────────────────────

GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_production

# Prometheus retention
PROMETHEUS_RETENTION=15d

# ─────────────────────────────────────────────────────────────────────────────
# BACKUPS (Phase 7)
# ─────────────────────────────────────────────────────────────────────────────

# 64 hex chars (openssl rand -hex 32). Falls back to SECRET_ENCRYPTION_KEY.
# Keep a copy OUTSIDE this server — without it encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# FUNCTIONS / QUEUES (Phase 8)
# ─────────────────────────────────────────────────────────────────────────────

# Allow webhook.dispatch jobs to call private/internal IPs (SSRF risk — keep false in production)
WEBHOOK_ALLOW_PRIVATE=false
# Seconds between cron scheduler ticks are set with CRON_TICK_MS (default 15000)

# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT / TESTING
# ─────────────────────────────────────────────────────────────────────────────

# When true, the auth service keeps sent emails in memory and exposes them at
# GET /auth/v1/<projectId>/_dev/emails?to=<email> (any project API key).
# Needed by the pytest suite. NEVER enable in production.
AUTH_DEV_MAILBOX=false

# Platform login attempts allowed per IP per 15 minutes (default 10). The pytest
# suite logs in many times from one IP, so raise this (e.g. 1000) when testing.
LOGIN_RATE_LIMIT_MAX=10

# node-exporter mounts the host root with ",rslave" propagation (needed on Linux).
# Docker Desktop on Windows/macOS rejects it: uncomment the empty value there.
# NODE_EXPORTER_ROOT_PROPAGATION=

# Optional OAuth endpoint overrides (used by tests to point at a mock provider).
# Leave unset in production. For the pytest suite on Docker Desktop, the mock runs
# on the test machine at port 9911: the browser-facing authorize URL uses
# localhost, the server-side URLs are called from inside the auth container.
# OAUTH_GITHUB_AUTHORIZE_URL=http://localhost:9911/authorize
# OAUTH_GITHUB_TOKEN_URL=http://host.docker.internal:9911/token
# OAUTH_GITHUB_USERINFO_URL=http://host.docker.internal:9911/user
# OAUTH_GITHUB_EMAILS_URL=http://host.docker.internal:9911/user/emails
# OAUTH_GOOGLE_AUTHORIZE_URL=
# OAUTH_GOOGLE_TOKEN_URL=
# OAUTH_GOOGLE_USERINFO_URL=

# Webhook test: the queue worker must be able to call the test machine.
# WEBHOOK_ALLOW_PRIVATE=true (above) and, on Docker Desktop:
# ODB_WEBHOOK_HOST=host.docker.internal

# ─────────────────────────────────────────────────────────────────────────────
# HIGH AVAILABILITY (Phase 10 — untested templates, see docs/ha.md)
# ─────────────────────────────────────────────────────────────────────────────

# PATRONI_REPLICATION_PASSWORD=
# PATRONI_ADMIN_PASSWORD=
