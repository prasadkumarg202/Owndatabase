##############################################################################
# OwnDatabase — Environment Variables
#
# Copy this file to .env and fill in all required values.
# NEVER commit .env to version control.
#
# Required values are marked with :?  (Docker Compose will fail without them)
# Optional values have defaults shown.
##############################################################################

# ─────────────────────────────────────────────────────────────────────────────
# GENERAL
# ─────────────────────────────────────────────────────────────────────────────

# Your domain name (use 'localhost' for local development)
DOMAIN=localhost

# Application environment
NODE_ENV=development

# Log level: error | warn | info | debug | trace
LOG_LEVEL=info

# Public-facing site URL (used for OAuth redirects, email links)
SITE_URL=http://localhost

# ─────────────────────────────────────────────────────────────────────────────
# POSTGRESQL
# ─────────────────────────────────────────────────────────────────────────────

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production_use_long_random_string
POSTGRES_DB=owndatabase

# ─────────────────────────────────────────────────────────────────────────────
# PGBOUNCER
# ─────────────────────────────────────────────────────────────────────────────

PGBOUNCER_MAX_CONN=200
PGBOUNCER_POOL_SIZE=25

# ─────────────────────────────────────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────────────────────────────────────

REDIS_PASSWORD=change_me_in_production_use_long_random_string
REDIS_MAX_MEMORY=256mb

# ─────────────────────────────────────────────────────────────────────────────
# JWT / SESSIONS
# ─────────────────────────────────────────────────────────────────────────────

# Must be at least 32 characters, random
# Generate: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32

# JWT expiry in seconds (default: 1 hour)
JWT_EXPIRES_IN=3600

# Refresh token expiry in seconds (default: 7 days)
REFRESH_TOKEN_EXPIRES_IN=604800

# ─────────────────────────────────────────────────────────────────────────────
# SECRET ENCRYPTION
# ─────────────────────────────────────────────────────────────────────────────

# Used to encrypt secrets at rest (AES-256-GCM)
# Must be exactly 32 bytes hex-encoded (64 hex chars)
# Generate: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=change_me_generate_with_openssl_rand_hex_32

# ── SECRETS VAULT (docs/vault.md) ───────────────────────────────────────────────
# Master keys, only given to the control API: "id:<64 hex>", comma-separated, first = active.
# Rotate: put a new key first, restart control-api (data keys are re-wrapped), then later drop the old one.
# Empty = a key derived from SECRET_ENCRYPTION_KEY (every service has that one: set this in production).
# Generate: echo "k1:$(openssl rand -hex 32)"
VAULT_MASTER_KEYS=
# Per-service tokens for reading secrets from the vault (openssl rand -hex 32 each)
VAULT_TOKEN_AUTH=
VAULT_TOKEN_API=
VAULT_TOKEN_QUEUE=

# Passwords of the services' own database roles (migration 023; openssl rand -hex 24 each)
DB_PASSWORD_AUTH=
DB_PASSWORD_API=
DB_PASSWORD_REALTIME=
DB_PASSWORD_STORAGE=
DB_PASSWORD_WORKER=
DB_PASSWORD_CRON=

# ─────────────────────────────────────────────────────────────────────────────
# OAUTH PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────

# Google OAuth (create at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth (create at github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL / SMTP
# ─────────────────────────────────────────────────────────────────────────────

# Leave blank in development (emails logged to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@localhost

# Phone OTP: platform-wide Twilio fallback. Projects can configure their own
# provider (Twilio or a signed webhook for MSG91/Gupshup/etc.) in Auth settings.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
# Platform defaults: {{code}} or {{ .Code }} is replaced by the code
SMS_TEMPLATE=
SMS_OTP_EXPIRY_MINUTES=
# Test numbers (no SMS; the fixed code always works): +919999999999=123456,+15555550100=000000
SMS_TEST_OTP=
# Country code for numbers typed without one (91 = India)
SMS_DEFAULT_COUNTRY_CODE=

# ─────────────────────────────────────────────────────────────────────────────
# OBJECT STORAGE
# ─────────────────────────────────────────────────────────────────────────────

# Storage backend: s3 (any S3-compatible service, incl. the bundled SeaweedFS) | fs (local disk volume)
STORAGE_BACKEND=s3
# Largest accepted upload in bytes (100 MB)
MAX_UPLOAD_SIZE=104857600

# MinIO credentials (local development)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change_me_in_production

# S3-compatible settings
# Bundled SeaweedFS (compose service "minio"): http://minio:8333
# For AWS S3: https://s3.amazonaws.com
# For Cloudflare R2: https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=http://minio:8333
S3_BUCKET=owndatabase
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change_me_in_production
S3_REGION=us-east-1
# Set to true for MinIO and non-AWS S3-compatible services
S3_FORCE_PATH_STYLE=true

# ─────────────────────────────────────────────────────────────────────────────
# DASHBOARD
# ─────────────────────────────────────────────────────────────────────────────

NEXT_PUBLIC_APP_NAME=OwnDatabase
# Control API URL as seen from the browser
NEXT_PUBLIC_CONTROL_API_URL=http://localhost/api

# ─────────────────────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost

# ─────────────────────────────────────────────────────────────────────────────
# MONITORING
# ─────────────────────────────────────────────────────────────────────────────

GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me_in_production

# Prometheus retention
PROMETHEUS_RETENTION=15d

# ─────────────────────────────────────────────────────────────────────────────
# BACKUPS (Phase 7)
# ─────────────────────────────────────────────────────────────────────────────

# 64 hex chars (openssl rand -hex 32). Required: backups have their own key.
# Keep a copy OUTSIDE this server — without it encrypted backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Older keys (comma-separated), only to restore backups made with them
BACKUP_DECRYPT_KEYS=

# Cluster backups with pgBackRest (whole database + WAL archive → point-in-time
# restore with scripts/pitr-restore.sh). REQUIRED. The repository is encrypted
# with this passphrase; keep a copy OUTSIDE this server and never change it for
# an existing repository (old backups would become unreadable).
PGBACKREST_CIPHER_PASS=change_me_generate_with_openssl_rand_hex_32

# Shared secret between api-service and the isolated functions runtime
FUNCTIONS_RUNTIME_TOKEN=change_me_generate_with_openssl_rand_hex_32
# How old the newest backup of each kind may get before the sidecar takes one (hours)
PGBACKREST_FULL_HOURS=168
PGBACKREST_DIFF_HOURS=24
PGBACKREST_INCR_HOURS=1

# ─────────────────────────────────────────────────────────────────────────────
# FUNCTIONS / QUEUES (Phase 8)
# ─────────────────────────────────────────────────────────────────────────────

# Allow webhook.dispatch jobs to call private/internal IPs (SSRF risk — keep false in production)
WEBHOOK_ALLOW_PRIVATE=false
# Seconds between cron scheduler ticks are set with CRON_TICK_MS (default 15000)

# ─────────────────────────────────────────────────────────────────────────────
# DEVELOPMENT / TESTING
# ─────────────────────────────────────────────────────────────────────────────

# When true, the auth service keeps sent emails in memory and exposes them at
# GET /auth/v1/<projectId>/_dev/emails?to=<email> (any project API key).
# Needed by the pytest suite. NEVER enable in production.
AUTH_DEV_MAILBOX=false

# Platform administrators can see cluster-wide data (raw Prometheus queries,
# cluster backups). The first account registered is an admin automatically;
# list more here (comma-separated). Organization owners are NOT platform admins.
PLATFORM_ADMIN_EMAILS=

# Usage limits given to every new project (JSON; bytes for sizes). Empty = unlimited.
# Platform admins can change a project's limits in Settings -> Usage & limits.
# DEFAULT_PROJECT_LIMITS={"api_requests_per_day":500000,"function_invocations_per_day":50000,"storage_bytes":1073741824,"database_bytes":524288000,"auth_users":50000,"realtime_connections":200}

# Billing (docs/billing.md). Off by default; platform admins can also switch it at runtime.
BILLING_ENABLED=false
# manual | stripe | razorpay
BILLING_PROVIDER=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# The pytest suite needs an admin account: add its email above and set
# ODB_ADMIN_EMAIL / ODB_ADMIN_PASSWORD (the tests create it if missing).
# ODB_ADMIN_EMAIL=admin@test.owndatabase.dev
# ODB_ADMIN_PASSWORD=

# Platform login attempts allowed per IP per 15 minutes (default 10). The pytest
# suite logs in many times from one IP, so raise this (e.g. 1000) when testing.
LOGIN_RATE_LIMIT_MAX=10

# node-exporter mounts the host root with ",rslave" propagation (needed on Linux).
# Docker Desktop on Windows/macOS rejects it: uncomment the empty value there.
# NODE_EXPORTER_ROOT_PROPAGATION=

# Optional OAuth endpoint overrides (used by tests to point at a mock provider).
# Leave unset in production. For the pytest suite on Docker Desktop, the mock runs
# on the test machine at port 9911: the browser-facing authorize URL uses
# localhost, the server-side URLs are called from inside the auth container.
# OAUTH_GITHUB_AUTHORIZE_URL=http://localhost:9911/authorize
# OAUTH_GITHUB_TOKEN_URL=http://host.docker.internal:9911/token
# OAUTH_GITHUB_USERINFO_URL=http://host.docker.internal:9911/user
# OAUTH_GITHUB_EMAILS_URL=http://host.docker.internal:9911/user/emails
# OAUTH_GOOGLE_AUTHORIZE_URL=
# OAUTH_GOOGLE_TOKEN_URL=
# OAUTH_GOOGLE_USERINFO_URL=

# Webhook test: the queue worker must be able to call the test machine.
# WEBHOOK_ALLOW_PRIVATE=true (above) and, on Docker Desktop:
# ODB_WEBHOOK_HOST=host.docker.internal

# ─────────────────────────────────────────────────────────────────────────────
# HIGH AVAILABILITY (Phase 10, optional — see docs/ha.md)
# ─────────────────────────────────────────────────────────────────────────────

# PATRONI_REPLICATION_PASSWORD=     # openssl rand -hex 24
# PATRONI_ADMIN_PASSWORD=           # openssl rand -hex 24
# HA_BACKUP_ENCRYPTION_KEY=         # openssl rand -hex 32 (WAL-G; keep a copy off-server)
# Off-site backup bucket (default: the bundled same-host backup-s3):
# HA_BACKUP_S3_PREFIX=s3://bucket/owndatabase
# HA_BACKUP_S3_ENDPOINT=https://s3.example.com
# HA_BACKUP_WALE_S3_ENDPOINT=https+path://s3.example.com:443
# HA_BACKUP_S3_ACCESS_KEY=
# HA_BACKUP_S3_SECRET_KEY=
# HA_BACKUP_SCHEDULE=0 1 * * *
# Tests: ODB_HA=1 runs tests/test_phase10_ha.py against the cluster
